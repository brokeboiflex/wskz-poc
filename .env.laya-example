# Extra comparison: typed decision -> adapter-generated tool call.
OPENAI_BASE_URL=http://laya-adapter:8000/v1
OPENAI_API_KEY=local-laya
OPENAI_MODEL=laya-multilingual
MODEL_BOOTSTRAP=external
MODEL_TIMEOUT_SECONDS=180
# Adapter supports auto|required, not named tool selection.
MODEL_TOOL_CHOICE=required
MODEL_MAX_TOKENS=1024
MODEL_TOKEN_LIMIT_FIELD=max_tokens
# Laya is a classifier; it has no generative sampling/reasoning options.
MODEL_REASONING_EFFORT=
MODEL_TEMPERATURE=
MODEL_TOP_P=
COMPOSE_PROFILES=laya
LAYA_THREADS=4
