# All Compose parameters. Defaults require no secrets and send ONLY to Mailpit.
COMPOSE_PROFILES=
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=gemma4:e2b
MODEL_BOOTSTRAP=ollama
MODEL_TIMEOUT_SECONDS=180
# Synthetic debugging only: raw request/response bodies in API logs, never credentials.
MODEL_TRACE=false
# Blank omits tool_choice. auto|required|named; named selects the sole email tool.
# Patched native Ollama enforces required; unsupported rendered paths return HTTP 400.
MODEL_TOOL_CHOICE=required
MODEL_MAX_TOKENS=1024
# The pinned Ollama reads max_tokens, not max_completion_tokens.
MODEL_TOKEN_LIMIT_FIELD=max_tokens
# Non-thinking mode, controlled by API rather than a prompt suffix.
# Empty values omit these optional fields for providers without support.
MODEL_REASONING_EFFORT=none
MODEL_TEMPERATURE=0
MODEL_TOP_P=0.8
MAILPIT_MAX_MESSAGES=10000
API_PORT=8000
MAILPIT_PORT=8025
MAIL_FROM=router@example.com
# Public PoC credential on an internal network, not a production secret.
MAILER_TOKEN=local-poc-mailer-token
LAYA_THREADS=4
