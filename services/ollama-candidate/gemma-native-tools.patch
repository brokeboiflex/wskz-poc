+	return m != nil && nativeGemma4Template(m) == "" && (m.Config.Renderer != "" || m.Config.Parser != "" || shouldUseHarmony(m) || shouldUseGoTemplate(m))
 }
 
 func shouldUseGoTemplate(m *Model) bool {
