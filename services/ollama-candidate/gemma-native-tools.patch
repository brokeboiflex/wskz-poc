diff --git a/server/native_gemma4.go b/server/native_gemma4.go
new file mode 100644
index 0000000..cd0ff67
--- /dev/null
+++ b/server/native_gemma4.go
@@ -0,0 +1,23 @@
+package server
+
+import _ "embed"
+
+// Google's canonical small Gemma 4 template, unchanged from
+// google/gemma-4-E2B-it revision 3e22461f65e89153144f8adb70e3b8c2cc9845a7.
+// SHA256: 0a2c8073c878ab1da004bee933a998606537bbb62016310352c7285c3f01c5b5.
+// The template activates llama.cpp's native Gemma parser and tool-name grammar.
+//
+//go:embed templates/gemma4-small.jinja
+var gemma4SmallNativeTemplate string
+
+func nativeGemma4Template(m *Model) string {
+	if m == nil || !m.isGGUF() || m.Config.Parser != "gemma4" || resolveRendererName(m) != gemma4RendererSmall {
+		return ""
+	}
+	// Preserve an explicitly selected Go template. The official Gemma package
+	// has renderer/parser metadata but no Go TEMPLATE or embedded chat template.
+	if shouldUseGoTemplate(m) {
+		return ""
+	}
+	return gemma4SmallNativeTemplate
+}
diff --git a/server/native_gemma4_test.go b/server/native_gemma4_test.go
new file mode 100644
index 0000000..ac9111c
--- /dev/null
+++ b/server/native_gemma4_test.go
@@ -0,0 +1,99 @@
+package server
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"testing"
+
+	"github.com/ollama/ollama/api"
+	gguftest "github.com/ollama/ollama/internal/testutil/gguf"
+	"github.com/ollama/ollama/llm"
+	"github.com/ollama/ollama/types/model"
+)
+
+func TestGemma4HandlerPassesToolsToNativeGrammar(t *testing.T) {
+	t.Setenv("OLLAMA_GO_TEMPLATE", "")
+	t.Setenv("OLLAMA_CONTEXT_LENGTH", "4096")
+	var tools []api.Tool
+	if err := json.Unmarshal([]byte(`[{"type":"function","function":{"name":"lookup_record","description":"Find a record","parameters":{"type":"object","properties":{"key":{"type":"string"}},"required":["key"]}}}]`), &tools); err != nil {
+		t.Fatal(err)
+	}
+	call := api.ToolCall{Function: api.ToolCallFunction{Name: "lookup_record", Arguments: testArgs(map[string]any{"key": "example"})}}
+	mock := mockRunner{ChatFn: func(_ context.Context, req llm.ChatRequest, fn func(llm.ChatResponse)) error {
+		fn(llm.ChatResponse{Message: api.Message{Role: "assistant", ToolCalls: []api.ToolCall{call}}, Done: true, DoneReason: llm.DoneReasonStop})
+		return nil
+	}}
+	s := newServerWithMockRunner(t, &mock)
+	createMinimalGGUFModel(t, s, "native-gemma-base", gguftest.KV{}, "", nil)
+	stream := false
+	w := createRequest(t, s.CreateHandler, api.CreateRequest{Model: "native-gemma-tools", From: "native-gemma-base", Renderer: "gemma4-small", Parser: "gemma4", Stream: &stream})
+	if w.Code != http.StatusOK {
+		t.Fatalf("create: %d %s", w.Code, w.Body.String())
+	}
+	w = createRequest(t, s.ChatHandler, api.ChatRequest{Model: "native-gemma-tools", Messages: []api.Message{{Role: "user", Content: "Find example"}}, Tools: tools, Stream: &stream})
+	if w.Code != http.StatusOK {
+		t.Fatalf("chat: %d %s", w.Code, w.Body.String())
+	}
+	if len(mock.ChatRequest.Tools) != 1 || mock.ChatRequest.Tools[0].Function.Name != "lookup_record" {
+		t.Fatal("Gemma tool schema never reached the native grammar")
+	}
+	var response api.ChatResponse
+	if err := json.Unmarshal(w.Body.Bytes(), &response); err != nil {
+		t.Fatal(err)
+	}
+	if len(response.Message.ToolCalls) != 1 || response.Message.ToolCalls[0].Function.Name != "lookup_record" {
+		t.Fatalf("native tool call did not survive response transport: %s", w.Body.String())
+	}
+}
+
+func TestGemma4NativeToolRoute(t *testing.T) {
+	t.Setenv("OLLAMA_GO_TEMPLATE", "")
+	for _, renderer := range []string{"gemma4", "gemma4-small"} {
+		// A renamed model must work from its existing architecture metadata.
+		m := &Model{Name: "renamed-model", Config: model.ConfigV2{
+			ModelFormat: "gguf", ModelType: "5.1B", Renderer: renderer, Parser: "gemma4",
+		}}
+		if got := chatModeForModel(m); got != chatExecutionModeNative {
+			t.Fatalf("Gemma tool calls bypass native grammar: mode = %v", got)
+		}
+		cfg := llamaServerConfigForModel(m)
+		if cfg.DisableJinja || cfg.ChatTemplate == "" {
+			t.Fatal("native Gemma requires the canonical template and preserved delimiters")
+		}
+	}
+}
+
+func TestGemma4NativeTemplateScope(t *testing.T) {
+	t.Setenv("OLLAMA_GO_TEMPLATE", "")
+	for _, tc := range []struct {
+		name, format, renderer, parser, size string
+		goTemplate                           bool
+	}{
+		{"large", "gguf", "gemma4-large", "gemma4", "31B", false},
+		{"legacy large", "gguf", "gemma4", "gemma4", "31B", false},
+		{"mlx", "safetensors", "gemma4", "gemma4", "5.1B", false},
+		{"parser only", "gguf", "", "gemma4", "5.1B", false},
+		{"different parser", "gguf", "gemma4-small", "gemma4-no-thinking", "5.1B", false},
+		{"explicit Go template", "gguf", "gemma4-small", "gemma4", "5.1B", true},
+		{"qwen", "gguf", "", "", "4B", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			m := &Model{HasGoTemplate: tc.goTemplate, Config: model.ConfigV2{
+				ModelFormat: tc.format, Renderer: tc.renderer, Parser: tc.parser, ModelType: tc.size,
+			}}
+			cfg := llamaServerConfigForModel(m)
+			if cfg.ChatTemplate != "" {
+				t.Fatal("unrelated execution path received the Gemma template")
+			}
+		})
+	}
+}
+
+func TestGemma4CanonicalTemplate(t *testing.T) {
+	if got := fmt.Sprintf("%x", sha256.Sum256([]byte(gemma4SmallNativeTemplate))); got != "0a2c8073c878ab1da004bee933a998606537bbb62016310352c7285c3f01c5b5" {
+		t.Fatalf("official template changed: %s", got)
+	}
+}
