diff --git a/llm/native_template_test.go b/llm/native_template_test.go
new file mode 100644
index 0000000..6ccfc9b
--- /dev/null
+++ b/llm/native_template_test.go
@@ -0,0 +1,32 @@
+package llm
+
+import (
+	"github.com/ollama/ollama/api"
+	"slices"
+	"testing"
+)
+
+func TestNativeTemplateRunnerArguments(t *testing.T) {
+	const template = "{{ messages[0].content }}"
+	got := appendJinjaArgs([]string{"base"}, LlamaServerConfig{ChatTemplate: template})
+	want := []string{"base", "--jinja", "--chat-template", template}
+	if !slices.Equal(got, want) {
+		t.Fatalf("native template/parser options = %q, want %q", got, want)
+	}
+	// A disabled native path must not accidentally activate this template.
+	got = appendJinjaArgs([]string{"base"}, LlamaServerConfig{DisableJinja: true, ChatTemplate: template})
+	want = []string{"base", "--no-jinja", "--chat-template", "chatml"}
+	if !slices.Equal(got, want) {
+		t.Fatalf("disabled native path = %q, want %q", got, want)
+	}
+}
+
+func TestNativeMessagePreservesThinkingWithTools(t *testing.T) {
+	msg, err := llamaServerChatMessage(Message{Role: "assistant", Thinking: "Need a lookup", ToolCalls: []api.ToolCall{{ID: "call_1", Function: api.ToolCallFunction{Name: "lookup"}}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if msg["reasoning_content"] != "Need a lookup" || msg["content"] != "" || len(msg["tool_calls"].([]llamaServerChatToolCall)) != 1 {
+		t.Fatalf("thinking/tool history lost during native transport: %#v", msg)
+	}
+}
