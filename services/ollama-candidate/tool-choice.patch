+package openai
+
+import (
+	"encoding/json"
+	"github.com/ollama/ollama/api"
+	"testing"
+)
+
+func TestChatToolChoiceWire(t *testing.T) {
+	for _, tc := range []struct {
+		raw, mode, name string
+		count           int
+		bad             bool
+	}{
+		{``, "", "", 2, false}, {`null`, "", "", 2, false},
+		{`"auto"`, "auto", "", 2, false}, {`"none"`, "none", "", 0, false},
+		{`"required"`, "required", "", 2, false},
+		{`{"type":"function","function":{"name":"second"}}`, "required", "second", 1, false},
+		{`"any"`, "", "", 0, true}, {`true`, "", "", 0, true},
+		{`{"type":"function","function":{"name":"missing"}}`, "", "", 0, true},
+	} {
+		t.Run(tc.raw, func(t *testing.T) {
+			body := `{"model":"example","messages":[{"role":"user","content":"hello"}],"tools":[{"type":"function","function":{"name":"first","parameters":{"type":"object"}}},{"type":"function","function":{"name":"second","parameters":{"type":"object"}}}]`
+			if tc.raw != "" {
+				body += `,"tool_choice":` + tc.raw
+			}
+			body += `}`
+			var req ChatCompletionRequest
+			if err := json.Unmarshal([]byte(body), &req); err != nil {
+				t.Fatal(err)
+			}
+			result, err := FromChatRequest(req)
+			if tc.bad {
+				if err == nil {
+					t.Fatal("accepted invalid choice")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if result.ToolChoice != tc.mode || len(result.Tools) != tc.count {
+				t.Fatalf("choice lost: %#v", result)
+			}
+			if tc.name != "" && result.Tools[0].Function.Name != tc.name {
+				t.Fatal("selected wrong tool")
+			}
+			wire, err := json.Marshal(result)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var decoded api.ChatRequest
+			if err = json.Unmarshal(wire, &decoded); err != nil {
+				t.Fatal(err)
+			}
+			if decoded.ToolChoice != tc.mode {
+				t.Fatal("API transport dropped choice")
+			}
+		})
+	}
+	if _, _, err := parseChatToolChoice(json.RawMessage(`"required"`), nil); err == nil {
+		t.Fatal("required accepted without tools")
+	}
+}
