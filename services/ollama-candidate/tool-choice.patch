+package server
+
+import (
+	"fmt"
+	"github.com/ollama/ollama/api"
+)
+
+func validateChatToolChoice(req *api.ChatRequest, m *Model) error {
+	switch req.ToolChoice {
+	case "", "auto":
+		return nil
+	case "none":
+		if chatModeForModel(m) != chatExecutionModeNative {
+			return fmt.Errorf("tool_choice none is unsupported by this model's rendered execution path")
+		}
+		req.Tools = nil
+		return nil
+	case "required":
+		if len(req.Tools) == 0 {
+			return fmt.Errorf("tool_choice required needs tools")
+		}
+		if chatModeForModel(m) != chatExecutionModeNative {
+			return fmt.Errorf("tool_choice required is unsupported by this model's rendered execution path")
+		}
+		return nil
+	default:
+		return fmt.Errorf("invalid tool_choice")
+	}
+}
