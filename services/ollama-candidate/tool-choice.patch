+package openai
+
+import (
+	"encoding/json"
+	"fmt"
+	"github.com/ollama/ollama/api"
+)
+
+// Normalize named selection for native engines that accept string choices.
+func parseChatToolChoice(raw json.RawMessage, tools api.Tools) (string, api.Tools, error) {
+	if len(raw) == 0 || string(raw) == "null" {
+		return "", tools, nil
+	}
+	var choice string
+	if err := json.Unmarshal(raw, &choice); err == nil {
+		switch choice {
+		case "auto":
+			return choice, tools, nil
+		case "none":
+			return choice, nil, nil
+		case "required":
+			if len(tools) > 0 {
+				return choice, tools, nil
+			}
+		}
+		return "", nil, fmt.Errorf("invalid tool_choice or required without tools")
+	}
+	var named struct {
+		Type     string `json:"type"`
+		Function struct {
+			Name string `json:"name"`
+		} `json:"function"`
+	}
+	if err := json.Unmarshal(raw, &named); err != nil || named.Type != "function" || named.Function.Name == "" {
+		return "", nil, fmt.Errorf("invalid tool_choice")
+	}
+	for _, tool := range tools {
+		if tool.Function.Name == named.Function.Name && tool.Type == "function" {
+			return "required", api.Tools{tool}, nil
+		}
+	}
+	return "", nil, fmt.Errorf("tool_choice names an undeclared function")
+}
