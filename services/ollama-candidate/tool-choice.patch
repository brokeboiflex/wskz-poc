+package llm
+
+import "testing"
+
+func TestNativeToolChoiceForwarding(t *testing.T) {
+	runner := &llamaServerRunner{}
+	for _, mode := range []string{"", "auto", "none", "required"} {
+		for _, stream := range []bool{false, true} {
+			body, err := runner.llamaServerChatRequest(ChatRequest{ToolChoice: mode}, stream)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if mode == "" {
+				if _, ok := body["tool_choice"]; ok {
+					t.Fatal("changed omitted default")
+				}
+			} else if body["tool_choice"] != mode {
+				t.Fatalf("tool_choice dropped: %v", body)
+			}
+		}
+	}
+}
