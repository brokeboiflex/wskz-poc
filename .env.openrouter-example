OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Required: replace locally; never commit a real key.
OPENAI_API_KEY=replace-with-your-openrouter-key
# Choose an available model with native tools support.
OPENAI_MODEL=qwen/qwen3-8b
MODEL_BOOTSTRAP=external
MODEL_TIMEOUT_SECONDS=180
# Request the sole email tool; the selected upstream must support named tool_choice.
MODEL_TOOL_CHOICE=named
MODEL_MAX_TOKENS=1024
MODEL_TOKEN_LIMIT_FIELD=max_tokens
# Set only options supported by your selected provider/model.
MODEL_REASONING_EFFORT=
MODEL_TEMPERATURE=
MODEL_TOP_P=
COMPOSE_PROFILES=
