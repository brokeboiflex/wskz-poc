# Optional: defaults also work without any .env file.
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3:4b-instruct-2507-q4_K_M
MODEL_BOOTSTRAP=ollama
MODEL_TIMEOUT_SECONDS=180
# Pinned Ollama ignores tool_choice; omit it.
MODEL_TOOL_CHOICE=
MODEL_MAX_TOKENS=1024
MODEL_TOKEN_LIMIT_FIELD=max_tokens
MODEL_REASONING_EFFORT=none
MODEL_TEMPERATURE=0
MODEL_TOP_P=0.8
COMPOSE_PROFILES=
